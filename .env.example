# Configuração do Banco de Dados (docker compose)
POSTGRES_DB=portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Conexão usada pela aplicação (Opção 2 do README)
# Formato: jdbc:postgresql://host:porta/banco
DATABASE_URL=jdbc:postgresql://localhost:5432/portal
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Configuração da Aplicação
PORT=8080
DDL_AUTO=update
SEED_SENHA=senac123
COOKIE_SECURE=false

# Para produção, altere:
# COOKIE_SECURE=true
# SEED_SENHA= (deixe vazio para não criar usuário demo)
# DATABASE_URL com o host/porta do banco gerenciado
